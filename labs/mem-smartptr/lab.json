    {"id": "single", "stdin": "1\n-7\n",            "stdout": "-7\n-7\n",          "points": 20},
    {"id": "empty",  "stdin": "0\n",                "stdout": "\n0\n",             "points": 20},
    {"id": "large",  "stdin": "5\n10 20 30 40 50\n", "stdout": "50 40 30 20 10\n150\n", "points": 30}
